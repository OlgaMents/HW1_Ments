class Rectangle(Shape):                                                        # Объявляем класс Прямоугольник, наследующий свойства класса Shape
    def __init__(self, a_m, b_m, raw_a, raw_b, unit_a, unit_b):                # Конструктор, принимающий метры, исходные значения и исходные единицы сторон
        self.a = a_m                                                           # Сохраняем длину первой стороны в метрах
        self.b = b_m                                                           # Сохраняем длину второй стороны в метрах
        self.raw_a = raw_a                                                     # Запоминаем исходное число первой стороны для вывода формулы
        self.raw_b = raw_b                                                     # Запоминаем исходное число второй стороны для вывода формулы
        self.unit_a = unit_a                                                   # Запоминаем исходную единицу измерения первой стороны
        self.unit_b = unit_b                                                   # Запоминаем исходную единицу измерения второй стороны

    def get_area(self):                                                        # Переопределяем метод расчета площади для прямоугольника
        return self.a * self.b                                                 # Возвращаем математическое произведение сторон в метрах

    def get_perimeter(self):                                                   # Переопределяем метод расчета периметра для прямоугольника
        return 2 * (self.a + self.b)                                           # Возвращаем удвоенную сумму сторон прямоугольника в метрах

    def get_formula_area(self):                                                # Переопределяем вывод формулы площади в текстовом виде
        return f"S = a * b -> {self.raw_a}{self.unit_a.value[0]} * {self.raw_b}{self.unit_b.value[0]} = {self.get_area():.4f} м²" # Строим строку подстановки

    def get_formula_perimeter(self):                                           # Переопределяем вывод формулы периметра в текстовом виде
        return f"P = 2 * (a + b) -> 2 * ({self.raw_a}{self.unit_a.value[0]} + {self.raw_b}{self.unit_b.value[0]}) = {self.get_perimeter():.4f} м" # Строим строку


