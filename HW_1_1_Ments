pythonimport datetime                                                                 # Импортируем стандартный модуль для работы с датой и временем
import math                                                                     # Импортируем математическую библиотеку для использования числа Пи
from enum import Enum                                                          # Импортируем базовый класс Enum для создания перечислений констант


class LinearUnit(Enum):                                                        # Объявляем перечисление для строгого контроля линейных единиц измерения
    MM = ("мм", 0.001)                                                         # Константа миллиметра и его коэффициент перевода в метры
    CM = ("см", 0.01)                                                          # Константа сантиметра и его коэффициент перевода в метры
    DM = ("дм", 0.1)                                                           # Константа дециметра и его коэффициент перевода в метры
    M = ("м", 1.0)                                                             # Константа метра (базовая эталонная единица)
    KM = ("км", 1000.0)                                                        # Константа километра и его коэффициент перевода в метры

    @classmethod                                                               # Декоратор для создания метода класса (работает с самим классом, а не объектом)
    def from_string(cls, text):                                                # Метод для безопасного поиска константы по её текстовому сокращению
        for unit in cls:                                                       # Перебираем все доступные константы в текущем перечислении
            if unit.value[0] == text.strip().lower():                          # Если текст пользователя совпал с зарегистрированным сокращением
                return unit                                                    # Возвращаем найденный объект константы
        return None                                                            # Если совпадений не найдено, возвращаем пустоту (None)


class UnitConverter:                                                           # Объявляем класс для перевода единиц измерения и площадей
    def __init__(self):                                                        # Конструктор для инициализации таблиц перевода
        self.area_units = {                                                    # Создаем словарь доступных мер площадей с коэффициентами к кв. метру
            "1": ("кв. мм", 0.000001),                                         # Вариант 1: квадратный миллиметр
            "2": ("кв. см", 0.0001),                                           # Вариант 2: квадратный сантиметр
            "3": ("кв. дм", 0.01),                                             # Вариант 3: квадратный дециметр
            "4": ("кв. м", 1.0),                                               # Вариант 4: квадратный метр
            "5": ("ар (сотка)", 100.0),                                        # Вариант 5: ар (земельная сотка)
            "6": ("гектар (га)", 10000.0),                                     # Вариант 6: гектар (земельная мера)
            "7": ("кв. км", 1000000.0)                                         # Вариант 7: квадратный километр
        }

    @staticmethod                                                              # Объявляем статический метод (работает как чистая функция без состояния)
    def to_meters(value, unit: LinearUnit):                                    # Метод перевода любого линейного значения в метры
        return value * unit.value[1]                                           # Умножаем число на коэффициент выбранной константы Enum

    def convert_area(self, area_in_m2, target_key):                            # Метод для конвертации площади из кв. метров в любую целевую меру
        unit_name, m2_per_unit = self.area_units[target_key]                   # Извлекаем название единицы и её вес в метрах по текстовому ключу
        return area_in_m2 / m2_per_unit, unit_name                             # Делим площадь на коэффициент и возвращаем кортеж из значения и имени


class Logger:                                                                  # Объявляем класс для ведения логов расчетов в файл
    def __init__(self, filename="geometry_history.log"):                       # Конструктор класса, принимающий имя файла по умолчанию
        self.filename = filename                                               # Сохраняем имя файла во внутреннее свойство объекта

    def log(self, message):                                                    # Метод для записи текстового сообщения в лог-файл
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")      # Получаем текущую дату и время в читаемом строковом формате
        with open(self.filename, "a", encoding="utf-8") as file:               # Открываем файл в режиме добавления текста ("a") с кодировкой UTF-8
            file.write(f"[{timestamp}] {message}\n")                           # Записываем временную метку, сообщение и делаем перенос строки


